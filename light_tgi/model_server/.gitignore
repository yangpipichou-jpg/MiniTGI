# --- Python 缓存 ---
__pycache__/
*.py[cod]
*$py.class

# --- 打包与分发 ---
dist/
build/
*.egg-info/
.eggs/

# --- Protobuf 自动生成的代码 (根据你的截图，建议保留，不要提交这些垃圾) ---
# 注意：如果你的 proto 文件在别处，这里生成的 pb2 文件就不要进仓库
**/*_pb2*.py
**/*_pb2*.pyi

# --- 虚拟环境 ---
.venv
venv
ENV

# --- Mypy ---
.mypy_cache/

# --- Pytest ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- 环境变量 (非常重要，防止泄露密钥) ---
.env
!.env.example